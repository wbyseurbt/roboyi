#usda 1.0
(
    "Converted from meshes/roboyi.urdf"
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "roboyi"
    kilogramsPerUnit = 1
    metersPerUnit = 1
